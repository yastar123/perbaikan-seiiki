{
  "name": "seiiki-app",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "build": "npm run build --workspace=@workspace/seiiki-listrik && esbuild server.ts --bundle --platform=node --format=cjs --external:express --external:cors --external:pg --external:drizzle-orm --external:pino --external:pino-http --external:cookie-parser --external:xlsx --external:@electric-sql/pglite --external:vite --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs",
    "db:push": "npm run push --workspace=@workspace/db",
    "db:push:force": "npm run push-force --workspace=@workspace/db",
    "lint": "tsc --build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@replit/connectors-sdk": "^0.4.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "@workspace/api-client-react": "*",
    "@workspace/api-server": "*",
    "@workspace/api-zod": "*",
    "@workspace/db": "*",
    "@workspace/seiiki-listrik": "*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "pg": "^8.13.3",
    "pino": "^9.14.0",
    "pino-http": "^10.4.0",
    "vite": "^7.3.2",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3"
  }
}
